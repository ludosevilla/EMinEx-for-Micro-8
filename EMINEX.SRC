//////////////////////
// Simple non-blocking modal windows for Micro-8
// Alert - Confirm - Items/file list selection
//
// V1.0 - Jean-arthur Silve - 2026
// 
// User interacts with mouse or keyboard
// Several windows can be opened.
// One window is active at a time.
// The last one is the active window.
// At closing, the previous one is active.
//////////////////////

type _boxType {
	byte id;
	byte tbox;
	byte x;
	byte y;
	byte width;
	byte height;
	nat closeX;
	nat closeY;
	nat btnAX;
	nat btnAY;
	nat btnBX;
	nat btnBY;
	bool btnUp;
	bool btnDwn;
	nat listAddr;
	byte lenList;
	int idxList;
	byte idxSelected;
	nat idxSelectedAddr;
};


type _boxTypeDItem {
	bool dir;
	text name={12};
};
 

// At closing the window, the hidden part of screen is displayed again
// So we need to save this part of screen
// Glyph+color to save from the hidden part is 2 bytes
// For example, a 40x10 window will use 800 bytes. 
// Here we setup where in memory we save it
// By default, we use the tile set memory
// This can be changed (be sure to have enough memory)
nat _boxVMem=0x3000; // Address to record the hidden part of screen 
byte _boxVMemPg=0x25;// Page
text _boxTxt={80};
text _boxDir={80};

_boxType _box[3];		// 3 windows max. Can be changed
byte _boxNum;

_boxTypeDItem _boxDItem[150];		// For directory listing, 150 items max. Can be changed.
byte _boxDItemNum;
byte _boxDclick;


void _boxAddPath(nat dirAddr) {
	byte i;
	byte j;
	byte c;
	i=0;
	while(true) {
		if (peek(&_boxDir+i)==0) break;
		i++;
	}
	
	if (peek(&_boxDir+i-1)!=47) {
		poke(&_boxDir+i,47);
		i++;
	}
	j=0;
	while(true) {
		c=peek(dirAddr+j);
		poke(&_boxDir+i+j,c);
		if (c==0)
			break;
		j++;
	}
}

void _boxRmPath() {
	byte i;
	while(true) {
		if (peek(&_boxDir+i)==0) break;
		i++;
	}
	i--;
	while(true && i!=255) {
		if (peek(&_boxDir+i)==47) break;
		i--;
	}
	if (i==255) return;
	if (i==0) {
		poke(&_boxDir,47);
		i++;
	}
	poke(&_boxDir+i,0);
}


// To call at start
void boxInit() {
	// Get the current path
	// Address 0x0608 may change in future version
	// of the O.S. (correct with 0.7.9)
	memCpy(0x0608,&_boxDir,80);
}


// Not to be called by user
byte _boxShow(byte id,byte tbox,byte x,byte y,byte width,byte height,text title) {
byte i;
byte j;
byte k;
byte l;

	if (_boxNum==#_box)
		return 255;

	_box[_boxNum].id=id; 
	_box[_boxNum].tbox=tbox; //0:alert 1:select 2:confirm
	_box[_boxNum].x=x;
	_box[_boxNum].y=y;
	_box[_boxNum].width=width;
	_box[_boxNum].height=height;
	_box[_boxNum].closeX=10*(x+width-2);
	_box[_boxNum].closeY=12*y;
	_box[_boxNum].btnUp=false;
	_box[_boxNum].btnDwn=false;
	_box[_boxNum].listAddr=0;

	txtWin(x,y,x+width,y+height);
	
	nat addr;
	for(i=0;i<height;i++) {
		addr = ((y+i)*80)+x;

		for(j=0;j<width;j++) {
			poke(_boxVMem,peek(0x1200+addr),_boxVMemPg);
			_boxVMem++;
			poke(_boxVMem,peek(0x1e80+addr),_boxVMemPg);
			_boxVMem++;			
			addr++;
		}
	}
		
	curPos(x,y);
	
	print("57‰");
	k=width-2;
	for(i=0;i<k;i++) 
		print("");
	print("Š");

	curPos(x+1,y);
	print(title);

	curPos(x+width-2,y);
	print("0a");
	
	l=height-1;
	for(i=1;i<l;i++) { 
		curPos(x,y+i);
		print("€");
		for(j=0;j<k;j++) 
			print(" ");
		print("€");
	}
	curPos(x,y+height-1);
	print("ˆ");
	for(i=0;i<k;i++) 
		print("");
	print("‡");

	txtWin(x+1,y+1,x+width-2,y+height-2);

	_boxNum++;
	return _boxNum-1;
}

// Close the last opened window
void boxClose() {
	if (_boxNum==0) return;
	_boxNum--;


	nat addr;
	for(int i=_box[_boxNum].height-1;i>=0;i--) {
		addr = ((_box[_boxNum].y+(byte)i)*80)+_box[_boxNum].x+(byte)_box[_boxNum].width-1;
		for(int j=_box[_boxNum].width-1;j>=0;j--) {
			_boxVMem--;						
			poke(0x1e80+addr,peek(_boxVMem,_boxVMemPg));
			_boxVMem--;
			poke(0x1200+addr,peek(_boxVMem,_boxVMemPg));
			addr--;
		}
	}
	if (_boxNum>0) {
		txtWin(_box[_boxNum-1].x+1,_box[_boxNum-1].y+1,_box[_boxNum-1].x+_box[_boxNum-1].width-2,_box[_boxNum-1].y+_box[_boxNum-1].height-2);
	} else
		txtWin(0,0,79,39);
}

// Close all windows
void boxCloseAll() {
	while(_boxNum>0) { boxClose();}
}

// Create an "alert box" with "Ok" button
// Window automatically closes
void boxAlert(byte id,byte x,byte y,byte width,byte height,text title,text msg[],byte numlines) {
byte bx;
nat addr;
byte j;
byte l;

	bx=_boxShow(id,0,x,y,width,height,title);
	if (bx!=255) {
		for(byte i=0;i<numlines;i++) {
			_boxTxt = msg[i];
			l=0;
			j=0;
			while(true) {
				if (peek(&_boxTxt+j)==0) break;
				if (peek(&_boxTxt+j)>=32) l++;
				j++;
			}
			curPos(x+((width-l)/2)+1,y+1+i);
			print("5");
			print(msg[i]);
			
		}
		x = x+(width-4)/2;
		y = y+height-2;
		curPos(x,y);
		print("be OK ");
		
		_box[bx].btnAX=10*x;
		_box[bx].btnAY=12*y;
	}

}

// Create a "confirm box" with "Yes" and "No" buttons
// Window automatically closes
void boxConfirm(byte id,byte x,byte y,byte width,byte height,text title,text msg[],byte numlines) {
byte bx;
byte x1;
byte y1;
byte j;
byte l;

	bx=_boxShow(id,2,x,y,width,height,title);
	if (bx!=255) {
		for(byte i=0;i<numlines;i++) {
			_boxTxt = msg[i];

			l=0;
			j=0;
			while(true) {
				if (peek(&_boxTxt+j)==0) break;
				if (peek(&_boxTxt+j)>=32) l++;
				j++;
			}
			curPos(x+((width-l)/2)+1,y+1+i);
			print("5");
			print(msg[i]);			
		}

		x1 = (x+(width-8)/2)-5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be  Yes   ");
		_box[bx].btnBX=10*x1;
		_box[bx].btnBY=12*y1;
	
		x1 = (x+(width-8)/2)+5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be   No   ");
		_box[bx].btnAX=10*x1;
		_box[bx].btnAY=12*y1;
	}
}


// Not to be called by user
void _boxShowList(byte bx) {
byte h;
byte y;
byte x;
byte k;
byte oh;
int idx;
nat addr;

	if (_box[bx].tbox == 3)
		oh=8;
	else oh=5;	
	h = _box[bx].height-oh;
	y = _box[bx].y+2;
	x = _box[bx].x+1;
	idx = _box[bx].idxList;
	
	
		
	for(byte i=0;i<h;i++) {
		curPos(x,y);
		if (idx<_box[bx].lenList) {
			if (_box[bx].tbox == 3) { // File selector
				memCpy(&_boxDItem+(nat)((14*idx)+1),&_boxTxt,13);
			} else {
				pokeW(&addr,peekW(_box[bx].listAddr+(nat)(2*idx))); 
				memCpy(addr,&_boxTxt,80);
			}
			
			if (idx == _box[bx].idxSelected) 
					print("5c",_boxTxt);
			else 
				if (_box[bx].tbox == 3 && _boxDItem[idx].dir)
					print("5f",_boxTxt);
				else
					print("52",_boxTxt);

			 k=0;
			
			while(peek(&_boxTxt+k)>0) {
				k++;
			}
			for(k=k;k<_box[bx].width-3;k++)
				print(" ");
			print("");
				
			idx++;
		} else {
			for(byte j=0;j<_box[bx].width-3;j++)
				print("5 ");
		}
		y++;
	}
	if (_box[bx].tbox == 3) {
		byte i=0;
		curPos(x,y+1);
		while(true) {
			if (peek(&_boxDir+i)==0) break;
			i++;
		}
		if (i<_box[bx].width-3) {
			print("57",_boxDir);
			for(byte j;j<_box[bx].width-3;j++)
				print(" ");
		} else {
			memCpy(&_boxDir+i-_box[bx].width+5,&_boxTxt,_box[bx].width-2);
			print("57..",_boxTxt);
		}

	}	
		
	if (_box[bx].idxList>0) {
		_box[bx].btnUp=true;
	} else _box[bx].btnUp=false;
	if (_box[bx].idxList+_box[bx].height-oh-1<(_box[bx].lenList-1)) {
		_box[bx].btnDwn=true;
	} else _box[bx].btnDwn=false;
	
	curPos(_box[bx].x+_box[bx].width-2,_box[bx].y+2);
	if (_box[bx].btnUp==true) {
		print("52c2");
	} else {
		print("52 ");
	}
	curPos(_box[bx].x+_box[bx].width-2,_box[bx].y+_box[bx].height-(oh-2));
	if (_box[bx].btnDwn==true) {
		print("52c3");
	} else {
		print("52 ");
	}
}

// Create a "list box" with one "Select" and one "Close" buttons
// Var pointed by idxSelected will be the index of selected item in 
// the list
// Window WILL NOT automatically closes when an item is selected.
void boxList(byte id,byte x,byte y,byte width,byte height,text title,nat listAddr,byte lenList,nat idxSelected) {
byte bx;
byte x1;
byte y1;


	bx=_boxShow(id,1,x,y,width,height,title);

	if (bx!=255) {

		x1 = (x+(width-8)/2)-5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be Select ");
		_box[bx].btnBX=10*x1;
		_box[bx].btnBY=12*y1;
	
		x1 = (x+(width-8)/2)+5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be Cancel ");
		_box[bx].btnAX=10*x1;
		_box[bx].btnAY=12*y1;
		
		_box[bx].listAddr=listAddr;
		_box[bx].lenList=lenList;
		_box[bx].idxList=0;
		_box[bx].idxSelected=0;
		_box[bx].idxSelectedAddr=idxSelected;
		poke(_box[bx].idxSelectedAddr,0);
		
		_boxShowList(bx);
		
	}
}

void _boxLoadDir(byte bx) {
bool b;
nat n;
	_boxDItemNum=0;
	fOpDir(_boxDir);
	while(true) {
		b = fRdDir(&_boxTxt,&n);
		if (peek(&_boxTxt)==0) break;
		_boxDItem[_boxDItemNum].dir = b;
		memCpy(&_boxTxt,&_boxDItem+(14*_boxDItemNum)+1,13);
		_boxDItemNum++;
		if (_boxDItemNum == #_boxDItem) break;
	}
	_box[bx].idxList=0;
	_box[bx].idxSelected=0;
	poke(_box[bx].idxSelectedAddr,0);
}

// Create a "file selector box" with one "Select" and one "Close" buttons
// Var pointed by idxSelected will be the index of selected item in 
// the _boxDItem
// fileName is the address of a text string will be set with selected file name
// (absolute path included)
// Window WILL NOT automatically closes when an item is selected.
// !!! One box max of this type must be open at one time !!!
void boxFileSelect(byte id,byte x,byte y,byte width,byte height,text title,nat fileNameAddr,nat idxSelected) {
byte bx;
byte x1;
byte y1;

	bx=_boxShow(id,3,x,y,width,height,title);


	if (bx!=255) {

		x1 = (x+(width-8)/2)-5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be Select ");
		_box[bx].btnBX=10*x1;
		_box[bx].btnBY=12*y1;
	
		x1 = (x+(width-8)/2)+5;
		y1 = y+height-2;
		curPos(x1,y1);
		print("be Cancel ");
		_box[bx].btnAX=10*x1;
		_box[bx].btnAY=12*y1;
		_box[bx].listAddr=fileNameAddr;

		_box[bx].idxSelected=0;
		_box[bx].idxSelectedAddr=idxSelected;
		poke(_box[bx].idxSelectedAddr,0);
		
		_boxLoadDir(bx);
		_box[bx].lenList=_boxDItemNum;
		
		_boxShowList(bx);
		
	}

}

// To be called in the main loop
// In case of event, return the boxId of the box, other wise 255
// Byte var pointed by retAddr is set to 0 if box is closed (ESC, or close button)
// Otherwise will be set to 1 (Yes button, Ok button, Select button...)
byte boxLoop(nat retAddr) {
	byte bx;
	int x;
	int y;
	byte key;
	byte i;
	byte mouse=0;
	byte selected=0;
				
	if (_boxNum==0) return 255;



	bx = _boxNum-1;

	poke(retAddr,255);
	
	if(_mouse==1) {
		if (_boxDclick==0) {
			mouse=1;
			_boxDclick=1;
		}
	} else {
		_boxDclick=0;
	}
	
	
	key = getKeyDwn();

	if (key==12 || (mouse==1 && _box[bx].height>0 && isPtrBox(_box[bx].closeX,_box[bx].closeY,_box[bx].closeX+10,_box[bx].closeY+12))) {
		poke(retAddr,0);
		boxClose();
		return _box[bx].id;
	}

	if (_box[bx].tbox==0) { // Alert box
		if (key==37 ||  (mouse==1 && isPtrBox(_box[bx].btnAX,_box[bx].btnAY,_box[bx].btnAX+40,_box[bx].btnAY+12))) {
			poke(retAddr,1);
			boxClose();
			return _box[bx].id;
		}
		return 255;
	}
	if (_box[bx].tbox==2) { // Confirm box
		if (key==12 || key==54 || (mouse==1 &&isPtrBox(_box[bx].btnAX,_box[bx].btnAY,_box[bx].btnAX+80,_box[bx].btnAY+12))) {
			poke(retAddr,0);
			boxClose();
			return _box[bx].id;
		}
		if (key==37 || key==64 || (mouse==1 && isPtrBox(_box[bx].btnBX,_box[bx].btnBY,_box[bx].btnBX+80,_box[bx].btnBY+12))) {
			poke(retAddr,1);
			boxClose();
			return _box[bx].id;
		}
	}
	if (_box[bx].tbox==1 || _box[bx].tbox==3) { // List box / file selector
		if (key==12 || (mouse==1 &&isPtrBox(_box[bx].btnAX,_box[bx].btnAY,_box[bx].btnAX+80,_box[bx].btnAY+12))) {
			poke(retAddr,0);
			boxClose();
			return _box[bx].id;
		}

		byte oh;
		if (_box[bx].tbox == 3)
			oh=8;
		else oh=5;	

		if (mouse==1) {
			mouseUpdt();
			x = (_box[bx].x+1)*10;
			y = (_box[bx].y+2)*12;
			if (isPtrBox(x,y,x+(10*(_box[bx].width-4)),y+(12*(_box[bx].height-oh)))) {
				y=(_mouseY/12);
				y =y-_box[bx].y-2+_box[bx].idxList;
				if (y>=0 && y<_box[bx].lenList) {
					i = _box[bx].idxSelected;
					if (i!=y) {
						poke(_box[bx].idxSelectedAddr,(byte)y);
						_box[bx].idxSelected=(byte)y;
						_boxShowList(bx);
						return 255;
					}
					selected=1;
				}
			} 
		}


		if (key==37 || (mouse==1 && ((selected==1) || (isPtrBox(_box[bx].btnBX,_box[bx].btnBY,_box[bx].btnBX+80,_box[bx].btnBY+12))))) {
			if (_box[bx].tbox==3) {
				i = _box[bx].idxSelected;
				if (_boxDItem[i].dir) {
					byte c1;
					byte c2;
					c1 = peek(&_boxDItem + (i*14)+1);
					c2 = peek(&_boxDItem + (i*14)+2);
					if (c1==46) {
						if (c2==46) {
							_boxRmPath();
						} else 
							return 255;
					} else {
						_boxAddPath(&_boxDItem + (i*14)+1);
					}
					_boxLoadDir((byte)bx);
					_box[bx].lenList=_boxDItemNum;
					_boxShowList(bx);
					return 255;
				}
				key=0;
				while(true) {
					if (peek(&_boxDir+key)==0) break;
					key++;
				}
				memCpy(&_boxDir,_box[bx].listAddr,key);
				if (peek(&_boxDir+key-1)!=47) {
					poke(_box[bx].listAddr+key,47);
					key++;
				}
				memCpy(&_boxDItem + (i*14)+1,_box[bx].listAddr+key,13);
			}
			poke(_box[bx].idxSelectedAddr,_box[bx].idxSelected);
			poke(retAddr,1);
			return _box[bx].id;
		}
		poke(_box[bx].retAddr,255);
		if (_box[bx].btnDwn==true) {
			x = (_box[bx].x+_box[bx].width-2)*10;
			y = (_box[bx].y+_box[bx].height-(oh-2))*12;
			if ( (mouse==1 && isPtrBox(x,y,x+10,y+12))) {
				_box[bx].idxList++;
				_boxShowList(bx);
				return 255;
			}
		}
		if (_box[bx].btnUp==true) {
			x = (_box[bx].x+_box[bx].width-2)*10;
			y = (_box[bx].y+2)*12;
			if ((mouse==1 && isPtrBox(x,y,x+10,y+12))) {
				_box[bx].idxList--;
				_boxShowList(bx);
				return 255;
			}
		}
			
		if (key==80) { // Down
			x = _box[bx].idxSelected;
			x++;
			if (x<_box[bx].idxList)
				x=_box[bx].idxList;
			else if (x==_box[bx].idxList+_box[bx].height-oh)
				_box[bx].idxList++;					
			if (x==_box[bx].lenList)
				x = _box[bx].lenList-1;
			_box[bx].idxSelected=(byte)x;
			_boxShowList(bx);
			return 255;
		} else if (key==77) { // Up
			x = _box[bx].idxSelected;
			x--;
			if (x<_box[bx].idxList) {
				if (_box[bx].idxList>0)
					_box[bx].idxList--;
				x=_box[bx].idxList;
			} else if (x>=_box[bx].idxList+_box[bx].height-oh)
				x = _box[bx].idxList+_box[bx].height-oh-1;
			_box[bx].idxSelected=(byte)x;
			_boxShowList(bx);
			return 255;
		}
	}
	return 255;
}

