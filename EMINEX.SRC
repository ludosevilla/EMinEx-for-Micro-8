void main() {
	text txt1[20];
	text txt2[20];
	text txt3[20];
	text fname[80];
	byte mainDisplayed;
	byte menuRet;
	byte idxSelected;
	byte boxId;
	
	
	// Starting
	bool stop=false;
	
	import("/system/reginit.dat",0x1100,0);
	poke(gfxModes,0);
	cls();
	clearSprites();
	clearTiles();
	clearTileSet();
	clearBitMap();	

	// Black background
	byte oldR=peek(0x2f13);
	byte oldG=peek(0x2f14);
	byte oldB=peek(0x2f15);
	poke(0x2f13,0);
	poke(0x2f14,0);
	poke(0x2f15,0);
	poke(statusReg,peek(0x2f0b)|0b10000000);// Mouse
	
	memSet(cpuWindow,48000,136,bmpPageA);
	memSet(cpuWindow,48000,136,bmpPageB);


	// Started

	import("res/font.bmp",cpuWindow,48000,tilPage);

	// Load sprites
	import("res/spr.spr",cpuWindow,0,sprPage);
	import("res/spr.pla",sprPlaA,48);

	sprRef(0,0);
	sprPal(0,0);
	sprPos(0,0,0);

	poke(gfxModes,peek(gfxModes) | 0b00010101); //Enable text sprites bitmap display

	
	init();
	boxInit();
	setColorMode(colorMode);
	setCursor(false);
	

	txt1[0]="";
	txt1[1]="2E M i n E x";
	txt1[2]="";
	txt1[3]="";
	txt1[4]="V 0.1";
	txt1[5]="";
	txt1[6]="";
	txt1[7]="bVideotex CEPT-2 Emulator";
	txt1[8]="";
	txt1[9]="";
	txt1[10]="4Jean-arthur Silve 2026";
	txt1[11]="GitHub: @ludosevilla";
	boxAlert(0,20,10,40,17,"Welcome!",txt1,12);

	while(true) {
		boxId=boxLoop(&menuRet);
		if (boxId!=255) break;
	}
	
	mainDisplayed=1;

	while(true) {
	
		while (true) {
			if (mainDisplayed==1 || (mainDisplayed==0 && getKeyDwn()==12)) {
				txt1[0]="fConnect";
				txt1[1]="View local files";
				txt1[2]="Local mode";
				txt1[3]="fTerminal mode";
				txt1[4]="Color/bw toggle";
				txt1[5]="Infos";
				txt1[6]="Exit";	
				boxList(0,3,3,25,12,"EMinEx main menu",&txt1,7,&idxSelected);
				mainDisplayed=2;
			}
			boxId=boxLoop(&menuRet);
			if (boxId!=255) break;
		}
		
		if (boxId==0) { // From main menu
			if (menuRet==0) { // Esc or close
				mainDisplayed=0;
				continue;
			}
			if (idxSelected==6) { // Exit prog
				boxClose();
				break;
			}
			if (idxSelected==0 || idxSelected==3) { // Connect or terminal
				txt2[0]="";
				txt2[1]="bSorry!";
				txt2[2]="";
				txt2[3]="bNot yet available!";
				boxAlert(1,29,15,22,9,"Not available",txt2,4);
				continue;
			}
			if (idxSelected==4) { // Display mode
				colorMode=1-colorMode;
				setColorMode(colorMode);
				txt2[0]="";
				txt2[1]="bVideotex display will be in";
				if (colorMode==0)
					txt2[2]="bBlack & White";
				else
					txt2[2]="bColors (8)";
				boxAlert(7,20,13,40,7,"Display mode",txt2,3);
				continue;
			}

			if (idxSelected==2) { // Local mode
				txt2[0]="";
				txt2[1]="bCtrl+letter keys: ASCII 1 to 26";
				txt2[2]="bCtrl+[0-4]: ASCII 27 to 31";
				txt2[3]="";
				txt2[4]="bFctn+ESC: exit local mode";
				boxAlert(5,20,13,40,9,"Local mode",txt2,5);
				continue;
			}
			if (idxSelected==1) { // View file
				txt2[0]="View file / Change current dir";
				txt2[1]="View all files of current dir";
				boxList(2,6,6,46,12,"View files",&txt2,2,&idxSelected);
				continue;
			}
			
			if (idxSelected==5) { // Infos
				txt2[0]="";
				txt2[1]="2EMinExb allows you to display pages in the CEPT-2 Videotex format,";
				txt2[2]="ba standard used by French Minitel terminals from 1980 to 2012.";
				txt2[3]="";
				txt2[4]="bThe Minitel was a pioneering online network,";
				txt2[5]="boffering a wide range of online services as early as the 1980s.";
				txt2[6]="";
				txt2[7]="bIt reached its peak in 1990, with several million users.";
				txt2[8]="and more than 25.000 services.";
				txt2[9]="";
				txt2[10]="bOnce Micro-8 has the ability to connect to the Internet,";
				txt2[11]="2EMinExb will provide access to Videotex services";
				txt2[12]="bthat are still operating today, notably MiniPavi (www.minipavi.fr).";
				txt2[13]="";
				txt2[14]="2EMinExb is also available for MSX computers.";
				boxAlert(6,5,8,70,21,"Info",txt2,15);
				continue;
			}
			
			continue;
		}
		
		if (boxId==1 || boxId==6 || boxId==7) { // From alert box "not available" / "Infos" / Color mode
			// Nothing to do: box is closed automatically
			continue;
		}

		if (boxId==2) { // From "View file" menu 
			if (menuRet==0) {
				// Closed : nothing to do: box is closed automatically
				continue;
			}
			if (idxSelected==0) { // Select file/dir
				boxFileSelect(3,9,9,40,20,"Select file",&fname,&idxSelected);
				continue;
			}
			txt3[0]="";
			txt3[1]="bCurrent dir is7";
			txt3[2]=_boxDir;
			txt3[3]="";
			txt3[4]="bESC: Next screen";
			txt3[5]="";
			txt3[6]="b2xESC: Exit";
			boxAlert(4,19,15,42,12,"Info",txt3,7);			
			continue;
		}
		
		
		if (boxId==3) { // From "Select file" menu 		
			if (menuRet==0) {
				// Closed : nothing to do: box is closed automatically
				continue;
			}
			boxCloseAll();
			mainDisplayed=1;
			displayFile(fname);
			continue;
		}
		
		if (boxId==4) { // From read dir info
			if (menuRet==0) {
				// Closed : nothing to do: box is closed automatically
				continue;
			}
			boxCloseAll();
			displayDir(_boxDir);
			sleep(500);
			mainDisplayed=1;
			continue;
		}
		if (boxId==5) { // From local mode info
			if (menuRet==0) {
				// Closed : nothing to do: box is closed automatically
				continue;
			}
			boxCloseAll();
			localMode();
			sleep(500);
			mainDisplayed=1;
			continue;
		}

	}


	// Exiting

	clearSprites();
	clearTiles();
	clearTileSet();
	clearBitMap();	
	cls();
			
	import("/system/reginit.dat",0x1100,0);
	
	poke(0x2f13,oldR);
	poke(0x2f14,oldG);
	poke(0x2f15,oldB);
	
	print("d                  e6e7e8e9eaebec93eeef");
	print("1Thanks for using  df6f7f8f9fafbfcfdfeff 1computer!");
}

