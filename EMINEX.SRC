void initVMem() {
	memSet(vMem1,1000,255,vMemPage);
	memSet(vMem2,1000,0b00100100,vMemPage);
	memSet(vMem3,1000,0b00010000,vMemPage);
	box(winXoffset*2,winYoffset,(winXoffset*2)+320,winYoffset+225,1);
	rect((winXoffset*2)-1,winYoffset-1,(winXoffset*2)+320,winYoffset+225,10);

}

void initAttr() {
	attFg=CWHITE;
	attBg=CBLACK;
	attBlink=0;
	attUl=0;
	attInvert=0;
	attSize=TAILLE_NORMALE;
	attPendingBg=255;
	attPendingUl=255;
	fontSet=FONT_G0;
	currC=0;
	currL=1;
	currSeq=TYPE_SEQ_NO;
	ligne00=false;
	skipDel=false;
}

void init() {
	winXoffset=20;
	winYoffset=4;
	initVMem();
	initAttr();
	videotexEnabled=true;
	modeRouleau=false;
}

void setColorMode(byte color) {
	if (color==0)
		import("res/bw.pal",bmpPal,48);
	else 
		import("res/color.pal",bmpPal,48);
}



// Small cache for chars rendering

byte _cacheSize = 30;
nat _cacheVal[540]; // 18* cachesize
byte _cachec[30];
byte _cachecFg[30];
byte _cachecBg[30];
byte _cachesize[30];
byte _cacheul[30];
nat _cacheOldval[18];
byte _idx;
byte _setIdx;

bool getDrawCharCache(byte lin,byte col,byte c,byte cFg,byte cBg,byte size,byte ul) {
	while(true) {
		for (byte i=_idx;i<_cacheSize;i++) {
			if (_cachec[i]==c && _cachecFg[i]==cFg && _cachecBg[i]==cBg && _cachesize[i]==size && _cacheul[i]==ul) {
				nat dstChar;
				nat n;
				_idx=i;
				dstChar= cpuWindow+(lin*1800)+(col*4) + (winXoffset+(winYoffset*200));
				n=i*18;
				for(byte j=0;j<9;j++) {
					pokeW(dstChar,_cacheVal[n+j],bmpPageA);
					pokeW(dstChar+2,_cacheVal[n+j+9],bmpPageA);
					dstChar+=200;
				}
				return true;
			}

		}
		if (_idx>0) 
			_idx=0;
		else return false;
	}
	return false;
}

void setDrawCharCache(byte c,byte cFg,byte cBg,byte size,byte ul) {
	if (_setIdx==_cacheSize)
		_setIdx=0;
	_cachec[_setIdx]=c;
	_cachecFg[_setIdx]=cFg;
	_cachecBg[_setIdx]=cBg;
	_cachesize[_setIdx]=size;
	_cacheul[_setIdx]=ul;
	memCpy(&_cacheOldval, &_cacheVal + (_setIdx*36),36);
	_idx=_setIdx;
	_setIdx++;
}


void drawChar(byte lin,byte col,byte c,byte cFg,byte cBg,byte size,byte ul) {
	// Displayed chars are reduced to 8x9, when Videotex CEPT2 is 8x10
	// Micro-8 has a vertical resolution of 240px
	// when minitel has a resolution of 250px
	//
	// Size (graphic mode only allow normal size):
	// 0 : normal
	// 1 : double width, left side
	// 2 : double width, right side
	// 3 : double height, top
	// 4 : double height, bottom
	// 5 : double size, top-left
	// 6 : double size, top-right
	// 7 : double size, bottom-left
	// 8 : double size, bottom-right
	

	nat dstChar;
	nat val;

	dstChar= cpuWindow+(lin*1800)+(col*4) + (winXoffset+(winYoffset*200));


	nat srcChar = ((c & 0x0f)*2000) + ((c>>4)*4) + cpuWindow;
	
	nat cBgH4 = cBg<<4;
	nat cFgH4 = cFg<<4;
	nat cBgH8 = cBg<<8;
	nat cFgH8 = cFg<<8;
	nat cBgH12 = cBg<<12;
	nat cFgH12 = cFg<<12;



	// Space - We don't use cache
	if (c==32 || c==160 ) {
		for(byte j=0;j<9;j++) {
			val = cBg + cBgH4 + cBgH8 + cBgH12;
			if (c==160 && ul==1) { 
				if (j!=2 && j!=6 && j!=8) {
					val = (val & 0xff0f)+cBgH4;
				}
			}
			pokeW(dstChar,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
			dstChar+=200;
			srcChar+=200;
		}
		if (ul==1 && c==32 && (size == 0 || size==1 || size==4 || size==7 || size==8)) {
			dstChar-=200;
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);				
		}
		
		return;
	}

	// Test if char is in cache
	bb=getDrawCharCache(lin,col,c,cFg,cBg,size,ul);
	if (bb==true) {
		return;
	}


	if (size ==0 ) { // Normal size

		for(byte j=0;j<9;j++) {
				
			val = peekW(srcChar,tilPage);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			if (c>=160 && ul==1) { 
				if (j!=2 && j!=6 && j!=8) {
					val = (val & 0xff0f)+cBgH4;
				} else {
					val = cBg + cBgH4 + cBgH8 + cBgH12;
				}
			}
			pokeW(dstChar,val,bmpPageA);

			val = peekW(srcChar+2,tilPage);

			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			if (c>=160 && ul==1) { 
				if (j!=2 && j!=6 && j!=8) {
					val = (val & 0xff0f)+cBgH4;
				} else {
					val = cBg + cBgH4 + cBgH8 + cBgH12;
				}
			}
			pokeW(dstChar+2,val,bmpPageA);
			
			dstChar+=200;
			srcChar+=200;
		}
		if (ul==1 && c<160) {
			dstChar-=200;
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);				
		}		
	} else if (size == 1) { //double width, left side
		nat val2;
		for(byte j=0;j<9;j++) {
			val = peekW(srcChar,tilPage);

			val = (val>>8)|(val<<8);
			
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);
			pokeW(dstChar,val2,bmpPageA);

			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);
			pokeW(dstChar+2,val2,bmpPageA);				

			dstChar+=200;
			srcChar+=200;
		}
		if (ul==1) {
			dstChar-=200;
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar+0,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
		}

	} else if (size == 2) { //double width, right side
		nat val2;
		for(byte j=0;j<9;j++) {				
			val = peekW(srcChar+2,tilPage);
			val = (val>>8)|(val<<8);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);
			pokeW(dstChar+0,val2,bmpPageA);

			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);
			pokeW(dstChar+2,val2,bmpPageA);				
			
			dstChar+=200;
			srcChar+=200;
		}
		if (ul==1) {
			dstChar-=200;
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar+0,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
		}

	} else if (size == 3) { //double height, top
		nat val2;
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+0,tilPage);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			pokeW(dstChar+(200*(2*j)),val,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1)),val,bmpPageA);
				
			val = peekW(srcChar+2,tilPage);

			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);				

			pokeW(dstChar+(200*(2*j))+2,val,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1))+2,val,bmpPageA);
			
			srcChar+=200;
		}
	} else if (size == 4) { //double height, bottom
		nat val2;
		srcChar+=1600;
		dstChar+=1600;
		
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+0,tilPage);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			pokeW(dstChar-(200*(2*j)),val,bmpPageA);
			
			if (j<4) pokeW(dstChar-(200*((2*j)+1)),val,bmpPageA);
				
			val = peekW(srcChar+2,tilPage);

			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			pokeW(dstChar-(200*(2*j))+2,val,bmpPageA);
			if (j<4) pokeW(dstChar-(200*((2*j)+1))+2,val,bmpPageA);
				
			srcChar-=200;
		}
		if (ul==1) {
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar+0,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
		}

	} else if (size == 5) { //double size, top-left
		nat val2;
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+0,tilPage);
			val = (val>>8)|(val<<8);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);
			
			pokeW(dstChar+(200*(2*j)),val2,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1)),val2,bmpPageA);

			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);

			pokeW(dstChar+(200*(2*j))+2,val2,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1))+2,val2,bmpPageA);
				
			srcChar+=200;
		}
	} else if (size == 6) { //double size, top-right
		nat val2;
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+2,tilPage);
			val = (val>>8)|(val<<8);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);
			
			pokeW(dstChar+(200*(2*j)),val2,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1)),val2,bmpPageA);

			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);

			pokeW(dstChar+(200*(2*j))+2,val2,bmpPageA);
			if (j<4) pokeW(dstChar+(200*((2*j)+1))+2,val2,bmpPageA);
				
			srcChar+=200;
		}
	} else if (size == 7) { //double size, bottom-left
		nat val2;
		srcChar+=1600;
		dstChar+=1600;
		
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+0,tilPage);
			val = (val>>8)|(val<<8);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);

			pokeW(dstChar-(200*(2*j)),val2,bmpPageA);
			
			if (j<4) pokeW(dstChar-(200*((2*j)+1)),val2,bmpPageA);
				
			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);
				
			pokeW(dstChar-(200*(2*j))+2,val2,bmpPageA);
			if (j<4) pokeW(dstChar-(200*((2*j)+1))+2,val2,bmpPageA);
				
			srcChar-=200;
		}
		if (ul==1) {
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar+0,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
		}

	} else if (size == 8) { //double size, bottom-right
		nat val2;
		srcChar+=1600;
		dstChar+=1600;
		
		for(byte j=0;j<5;j++) {
				
			val = peekW(srcChar+2,tilPage);
			val = (val>>8)|(val<<8);
				
			if ((val & 0x000f)==0) val= cBg + (val & 0xfff0);
			else val= cFg + (val & 0xfff0);
			if ((val & 0x00f0)==0) val= cBgH4 + (val & 0xff0f);
			else val= cFgH4 + (val & 0xff0f);
			if ((val & 0x0f00)==0) val= cBgH8 + (val & 0xf0ff);
			else val= cFgH8 + (val & 0xf0ff);
			if ((val & 0xf000)==0) val= cBgH12 + (val & 0x0fff);
			else val= cFgH12 + (val & 0x0fff);			

			val2 = (val & 0xf000) + (val & 0xf000)>>4;
			val2 += (val & 0x0f00)>>4 + (val & 0x0f00)>>8;
			val2 = (val2>>8)|(val2<<8);

			pokeW(dstChar-(200*(2*j)),val2,bmpPageA);
			
			if (j<4) pokeW(dstChar-(200*((2*j)+1)),val2,bmpPageA);
				
			val2 = (val & 0x00f0)<<8 + (val & 0x00f0)<<4;
			val2 += (val & 0x000f) + (val & 0x000f)<<4;
			val2 = (val2>>8)|(val2<<8);
				
			pokeW(dstChar-(200*(2*j))+2,val2,bmpPageA);
			if (j<4) pokeW(dstChar-(200*((2*j)+1))+2,val2,bmpPageA);
				
			srcChar-=200;
		}
		if (ul==1) {
			val = cFg + cFgH4 + cFgH8 + cFgH12;
			pokeW(dstChar+0,val,bmpPageA);
			pokeW(dstChar+2,val,bmpPageA);
		}

	}
	
	// Set the computed char in cache
	dstChar= cpuWindow+(lin*1800)+(col*4) + (winXoffset+(winYoffset*200));
	for(byte j=0;j<9;j++) {
		_cacheOldval[j]=peekW(dstChar,bmpPageA);
		_cacheOldval[j+9]=peekW(dstChar+2,bmpPageA);
		dstChar+=200;
	}
	setDrawCharCache(c,cFg,cBg,size,ul) ;
}


void render(byte lin,byte col, byte len) {
nat of;
nat llin;
byte a1;
byte a2;
byte a3;
byte cFg;
byte cBg;
byte tmp;

	llin = 40*lin+col;
	for(byte i=0;i<len;i++) {
		of = llin+i;
		a1=peek(vMem1+of,vMemPage);
		a2=peek(vMem2+of,vMemPage);
		a3=peek(vMem3+of,vMemPage);

		cFg = (a2 & 0b11100000)>>5;
		cBg = (a2 & 0b00011100)>>2;

		if ((a3 & 0b01000000)!=0) {
		
			tmp=cFg;
			cFg=cBg;
			cBg=tmp;
		}
		// Masquage non gere

		if ((a3 & 0b00010000)!=0 && fontSet==FONT_G0)
			// No underline if separator font G0
			drawChar(lin,col,a1,cFg,cBg,(a3 & 0b00001111),0);
		else 
			drawChar(lin,col,a1,cFg,cBg,(a3 & 0b00001111),(a2 & 0b00000010)>>1);
		col++;
		if (col>39) break;
	}
}

// Set a char in the video memory
// Videotex constraints managing
void setChar(byte lin,byte col,byte c,bool nodelim) {
// c>=160 : semigraphics
nat of;
nat maxOf;
nat n;
nat n2;
byte a3;
byte a2;
byte a1;
byte bg;
byte ul;
byte prevBg;
byte prevUl;
byte st=0;
byte sz;

	retLn0=0;
	retLn1=0;
	while(true) {
		if (st==0) {
			if (attSize==0) 
				sz=0;
			else if (attSize==1) // dwidth
				sz=1;
			else if (attSize==2) // dheight
				sz=4;
			else sz =7;
		} else if (st==1) {
			if (attSize==1) { // dwidth
				sz=2;
				col++;
			} else if (attSize==2) {// dheight
				sz=3;
				lin--;
			} else {
				sz =8;
				col++;
			}
		} else if (st==2) {
			sz = 5;
			lin--;
			col--;
		} else {
			sz =6;
			col++;
		}

		if (col<40 && lin>=0) {
			n=40*lin;
			of = n+col;
			a3=peek(vMem3+of,vMemPage);

			// Get bg color and underline status from previous char
			if (fontSet == FONT_G1) {
				prevBg = attBg;
				prevUl = attUl;
			} else if (col>0) {
				n2 = n+col-1;
				a1 = peek(vMem1+n2,vMemPage);				
				a2 = peek(vMem2+n2,vMemPage);
				prevBg = (a2 & 0b00011100) >> 2;
				if (a1<160)
					prevUl = (a2 & 0b00000010) >> 1;
				else prevUl=0;
			} else {
				prevBg = CBLACK;
				prevUl = 0;
			}

			poke(vMem1+of,c,vMemPage);
			if ((c!=32 && c<160) || nodelim==true) { // This is NOT a delimiter
				// Display char with fg color, previous char bgcolor and previous char undeline
				a2 = attFg<<5 + prevBg<<2 + prevUl<<1;
				poke(vMem2+of,a2,vMemPage);
				a2 = attInvert<<6 + attBlink<<5 + sz; 
				poke(vMem3+of,a2,vMemPage);
				if ((a3 & 0b00010000)>0) { // We place it on a delimiter			
					nat i;
					//Extend previous bgcolor and previous underline untril next delimiter (not included) or EOL
					maxOf = n+39;
					for (i=of+1;i<=maxOf;i++) {
						n2=vMem2+i;
						a2 = peek(n2,vMemPage);
						if ((a2&0b00011100)>>2==prevBg && (a2&0b00000010)>>1==prevUl ) break;
						a3 = peek(vMem3+i,vMemPage);
						if ((a3 & 0b00010000)>0) break;
						poke(n2,(a2 & 0b11100000) + prevBg<<2 + prevUl<<1,vMemPage);
					}
					// Number of chars to be rendered for current line and previous line (if needed)
					if (sz<=2 || sz==4 || sz==7 || sz==8)
						retLn0=(byte)(i-of);
					else retLn1=(byte)(i-of);
					
				} else {
					if (sz<=2 || sz==4 || sz==7 || sz==8)
						retLn0=1;
					else retLn1=1;
				}
			} else { // This is a potential delimiter
				nat i;
				byte delimiter=0;
				// Display char with fg color, potential bgcolor and potential undeline
				if (attPendingBg!=255) {
					bg = attPendingBg;
					if (sz==0 || sz==2 || sz==3 || sz==6) {
						attPendingBg=255;
						attBg=bg;
					}
					delimiter=1;
				}
				if (attPendingUl!=255) {
					ul = attPendingUl;
					if (sz==0 || sz==2 || sz==3 || sz==6) {
						attPendingUl=255;
						attUl=ul;
					}
					delimiter+=2;
				}
				if (delimiter==0) {
					// If not a delimiter, previous bgcolor and undeline
					bg = prevBg;
					ul = prevUl;
					if (fontSet == FONT_G1) 
						delimiter=1;
				} else {
					//Otherwise, current bgcolor/undeline if not changed
					if (delimiter==1) {
						ul = prevUl;
					} else if (delimiter==2) {
						bg = prevBg;
					}
					delimiter=1;
				}				
				
				a2 = attFg<<5 + bg<<2 + ul<<1;
				poke(vMem2+of,a2,vMemPage);
				a3 = attInvert<<6 + attBlink<<5 + delimiter<<4 + sz; 
				poke(vMem3+of,a3,vMemPage);
				//Extend bgcolor and underline untril next delimiter (not included) or EOL
				maxOf = n+39;
				for (i=of+1;i<=maxOf;i++) {

					a3 = peek(vMem3+i,vMemPage);
					a2 = peek(vMem2+i,vMemPage);
					if ((a3 & 0b00010000)>0 || ( (a2&0b00011100)>>2==bg && (a2&0b00000010)>>1==ul) ) break;
					a2 = (a2 & 0b11100000) + bg<<2 + ul<<1;
					poke(vMem2+i,a2,vMemPage);
				}
				// Number of chars to be rendered for current line and previous line (if needed)				
				if (sz<=2 || sz==4 || sz==7 || sz==8)
					retLn0=(byte)(i-of);
				else retLn1=(byte)(i-of);
				
			}
		}
		// Processing other "parts" of character
		if (attSize==0)
			break;
		if ((attSize==1 || attSize==2) && st==1)
			break;
		if (attSize==3 && st==3)
			break;
		st++;
	}
	if (attSize==1 || attSize==3) {
		retLn0++;
		if (attSize==3)
			retLn1++;
	}
}


void sendToDisplay(byte car, bool all) {

	if (all==true || car>=32) {
		setChar((byte)currL,(byte)currC,car,skipDel);
		render((byte)currL,(byte)currC,retLn0);
		if (retLn1>0)
			render((byte)(currL-1),(byte)currC,retLn1);
		
		if (attSize == TAILLE_DOUBLE_LARGEUR || attSize == TAILLE_DOUBLE_TAILLE)
			currC+=2;
		else currC++;
		if (currC>39 && fontSet == FONT_G0) {
			// In text mode, background become black and no underline if we go to the following line
			// BG color and underline status are kept to be possibly revalidated 
			// if we have a zone delimiter
			skipDel=true;
			attPendingBg=attBg;
			attPendingUl=attUl;
			attBg = CBLACK;	
			attUl = 0;
		}
		lastChar = car;
		
	}
}

void clearEOL(byte lin,byte col) {
byte i;
	i = col;
	while(true) {
		if (fontSet==FONT_G0)
			setChar(lin,i,32,true);
		else setChar(lin,i,160,false);
		if (attSize==TAILLE_DOUBLE_LARGEUR || attSize==TAILLE_DOUBLE_TAILLE) 
			i+=2;
		else i++;
		if (i>=40) break;
	}	
	i=40-col;
	render(lin,col,i);
	if ((attSize==TAILLE_DOUBLE_HAUTEUR || attSize==TAILLE_DOUBLE_TAILLE) && lin>1) {
		render(lin-1,col,i);
	}
}

void posCursor() {
	sprPos(0,(currC*16)+48+(winXoffset*4),(currL*18)+42+(winYoffset*2));
	sprUpdt();
	return;
}

void scroll(byte direction) {
	if (direction==0) {
		// Up
		areaCpy(cpuWindow,200,winXoffset,winYoffset+18,200,207,cpuWindow,200,winXoffset,winYoffset+9,bmpPageA);
		areaSet(cpuWindow,200,winXoffset,winYoffset+216,160,9,17,bmpPageA);
			
		memCpy(vMem1+80,vMem1+40,920,vMemPage);
		memCpy(vMem2+80,vMem2+40,920,vMemPage);
		memCpy(vMem3+80,vMem3+40,920,vMemPage);

		memSet(vMem1+960,40,255,vMemPage);
		memSet(vMem2+960,40,0b00100100,vMemPage);
		memSet(vMem3+960,40,0b00010000,vMemPage);
	} else {
		// Down
		for(byte i=23;i>0;i--) {
			areaCpy(cpuWindow,200,winXoffset,winYoffset+(i*9),200,9,cpuWindow,200,winXoffset,winYoffset+(i*9)+9,bmpPageA);

			memCpy(vMem1+(40*i),vMem1+(40*i)+40,40,vMemPage);
			memCpy(vMem2+(40*i),vMem2+(40*i)+40,40,vMemPage);
			memCpy(vMem3+(40*i),vMem3+(40*i)+40,40,vMemPage);
		}
		areaSet(cpuWindow,200,winXoffset,winYoffset+9,160,9,17,bmpPageA);
		memSet(vMem1+40,40,255,vMemPage);
		memSet(vMem2+40,40,0b00100100,vMemPage);
		memSet(vMem3+40,40,0b00010000,vMemPage);
	}
	return;

}
void setCursor(bool state) {
// display or not the cursor
	if (state==false)
		sprRef(0,1);
	else
		sprRef(0,0);
	sprUpdt();
}

void correctPosCurseur() {
	if (ligne00==true) {
		if (currC <0)
			currC =0;
		else if (currC >39)
			currC =39;
		if (currL !=0)
			currL = 0;
		posCursor();
		return;
	}
	if (currC <0) {
		currC = 39;
		currL--;
	} else if (currC >39) {
		currC = 0;
		if (lastChar>=32) {
			if (attSize == TAILLE_NORMALE || attSize == TAILLE_DOUBLE_LARGEUR)
				currL++;
			else currL+=2;
		}else currL++;
	}
	if (currL<1) {
		if (modeRouleau == true) {
			scroll(1);	// Down
			currL = 1;
		} else {
			currL = 24;
		}
	} else 	if (currL>24) {
		if (modeRouleau == true) {
			scroll(0);	// Up
			currL = 24;
		} else {
			currL = 1;
		}
	} 
	
	posCursor();
}


void seqIGN() {
	seqCnt--;
	if (seqCnt==0)
		currSeq = TYPE_SEQ_NO;
	return;
}
	
void seqREP(byte car) {
	currSeq = TYPE_SEQ_NO;
	car-=63;
	while (car>1) {
		sendToDisplay(lastChar,false);
		correctPosCurseur(); 
		car --;
	}
	return;
}




void seqPOS(byte car) {
byte i;
byte j;
	if (seqCnt==0) {
		seqCnt = car;
		return;
	}
	currSeq = TYPE_SEQ_NO;
	
	if (seqCnt>=48 && seqCnt<=50) {
		// Type: line number (00-24)
		seqCnt-=48;
		i=10*seqCnt;
		car-=48;
		if (i==20 && car>4)
			return;
		i+=car;
		j=1;
	} else {
		// Type: LC
		i = seqCnt-64;
		if (i>24)
			return;
		j = car-64;
		if (j<1 || j>40)
			return;
	}
	currLold = currL;
	currCold = currC;

	initAttr();		
	if (i==0) {
		ligne00 = true;
	}
	currL = i;
	currC = j-1;
	posCursor();
	return;
}

void seqPRO1(byte car) {
	if (car == 0x7B) {
		// Identification
		// To do when connection will be possible
	}
	currSeq = TYPE_SEQ_NO;
	return;
}

void seqPRO2(byte car) {
	if (seqCnt == 0) {
		ProBuffer[0] = car;
		seqCnt++;
		return;
	}
	if (car == 0x43) {
		if (ProBuffer[0]==0x69) {
			// Rouleau on
			modeRouleau = true;
		} else if (ProBuffer[0]==0x6A) {
			// Rouleau off
			modeRouleau = false;
		}
	}
	currSeq = TYPE_SEQ_NO;
	return;
}

byte seqG2(byte car) {
	if (seqCnt==0 && (car == 0x42 || car == 0x41 || car == 0x4B || car == 0x43 || car == 0x48) ) {
		// Accent : waiting for a letter
		seqCnt = car;
		return 255;
	} 
	if (seqCnt==0) {
		// No accent received -> special char ?
		if (car==0x7A) { //oe
			car = 12;
		} else if (car==0x7B) { //beta
			car = 13;
		} else if (car==0x27) { //paragraph
			car = 14;
		} else if (car==0x6A) { //OE
			car = 11;
		} else if (car==0x23) { //pound
			car = 0;
		} else if (car==0x30) { //deg
			car = 5;
		} else if (car==0x31) { //+-
			car = 6;
		} else if (car==0x2C) { //left arrow
			car = 1;
		} else if (car==0x2D) { //up arrow
			car = 2;
		} else if (car==0x2E) { //right arrow
			car = 3;
		} else if (car==0x2F) { //down arrow
			car = 4;
		} else if (car==0x38) { //divide
			car = 7;
		} else if (car==0x3C) { //1/4
			car = 8;
		} else if (car==0x3D) { //1/2
			car = 9;
		} else if (car==0x3E) { //3/4
			car = 10;
		} else {
			car =255;
		}
	} else {
		if (seqCnt==0x43) { // circonflexe
			if (car == 117) car =24;	// u
			else if (car == 101) car = 21;	//e
			else if (car == 97) car = 20;	//a
			else if (car == 105) car = 22;	// i
			else if (car == 111) car = 23;	// o
			else if (car == 117) car = 24;	//u
			else car = 255;
		} else if (seqCnt==0x42) { // aigu
			if (car == 101) car =19;	// e
			else if (car == 69) car = 69;	//E
			else car = 255;
		} else if (seqCnt==0x41) { // grave
			if (car == 101) car = 17;	// e
			else if (car == 69) car = 69;	//E
			else if (car == 65) car = 65;	//A
			else if (car == 117) car = 18;	//u
			else if (car == 97) car = 16;	//a
			else car = 255;
		} else if (seqCnt==0x48) { // trema
			if (car == 69) car = 69;	//E
			else if (car == 101) car = 26;	// e
			else if (car == 105) car = 27;	// i
			else if (car == 111) car = 28;	// o
			else if (car == 117) car = 29;	// u
			else if (car == 97) car = 25;	//a
			else car = 255;
		} else if (seqCnt==0x4B) { // cedille
			if (car == 67) car = 31;	//C
			else if (car == 99) car = 30;	//c
			else car = 255;
		} else {
			car = 255;
		}

	}
	currSeq = TYPE_SEQ_NO;
	return car;
}

void seqESC(byte car) {
	if (car==0x1B) 
		return;
	if (car==0x35 || car==0x36 || car==0x37) {
		currSeq = TYPE_SEQ_IGNORE;
		seqCnt=1;
		return;
	}
	if (car==0x39) {	// PRO1
		currSeq = TYPE_SEQ_PRO1;
		seqCnt=0;
		return;
	}
	if (car==0x3A) {	// PRO2
		currSeq = TYPE_SEQ_PRO2;
		seqCnt=0;
		return;
	}
	if (car==0x3B) {	// PRO3
		currSeq = TYPE_SEQ_IGNORE;
		seqCnt=3;
		return;
	}	
	if (car==0x4C) {
		if (fontSet==FONT_G0)	// Char sizes only for G0 font
			attSize = TAILLE_NORMALE;
	} else if (car==0x4D) {
		if (fontSet==FONT_G0)
			attSize = TAILLE_DOUBLE_HAUTEUR;
	} else if (car==0x4E) {
		if (fontSet==FONT_G0)
			attSize = TAILLE_DOUBLE_LARGEUR;
	} else if (car==0x4F) {
		if (fontSet==FONT_G0)
			attSize = TAILLE_DOUBLE_TAILLE;
	} else if (car==0x40) {		// Black fg
		attFg = CBLACK;
	} else if (car==0x41) {		// Red fg
		attFg = CRED;
	} else if (car==0x42) {		// Green fg
		attFg = CGREEN;
	} else if (car==0x43) {		// Yellow fg
		attFg = CYELLOW;
	} else if (car==0x44) {		// Blue fg
		attFg = CBLUE;
	} else if (car==0x45) {		// Magenta fg
		attFg = CMAGENTA;
	} else if (car==0x46) {		// Cyan fg
		attFg = CCYAN;
	} else if (car==0x47) {		// White fg
		attFg = CWHITE;
	} else if (car==0x50) {		// Black bg
		attPendingBg = CBLACK;
		skipDel=false;
	} else if (car==0x51) {		// Red bg
		attPendingBg = CRED;
		skipDel=false;
	} else if (car==0x52) {		// Green bg
		attPendingBg = CGREEN;
		skipDel=false;
	} else if (car==0x53) {		// Yellow bg
		attPendingBg = CYELLOW;
		skipDel=false;
	} else if (car==0x54) {		// Blue bg
		attPendingBg = CBLUE;
		skipDel=false;
	} else if (car==0x55) {		// Magenta bg
		attPendingBg = CMAGENTA;
		skipDel=false;
	} else if (car==0x56) {		// Cyan bg
		attPendingBg = CCYAN;
		skipDel=false;
	} else if (car==0x57) {		// White bg
		attPendingBg = CWHITE;
		skipDel=false;
	} else if (car==0x59) {		// End of underline
		attPendingUl = 0;
		skipDel=false;
	} else if (car==0x5A) {		// Start of undeline
		attPendingUl = 1;
		skipDel=false;
	} else if (car==0x5C) {		// Inverse off
		attInvert = 0;
	} else if (car==0x5D) {		// Inverse on
		if (fontSet==FONT_G0)
			attInvert = 1;
	}
	currSeq = TYPE_SEQ_NO;
	return;
}


void beep() {
	synInit(0);
	synNoteOff(0);
	synVoice(0,1,6,0b11,15); //id,wform,octave,pan,volume
	synEnv(0,3,0,0,0);//id,attack,delay,sustain,release
	synNoteOn(0,90,120);//voice, note, velocity
	return;
}
	



void inChar(byte car) {
	if (car<1 || car>127)
		return;
		
	if (videotexEnabled==false) {
		if (car == VDT_LEFT)
			currC--;
		else if (car == VDT_RIGHT)
			currC++;
		else if (car == VDT_DOWN)
			currL++;
		else if (car == VDT_UP)
			currL--;
		else if (car == VDT_CR)
			currC=0;

		sendToDisplay(car,false);
		correctPosCurseur();
		return;
	}
	
	if (currSeq !=0) {
		if (currSeq == TYPE_SEQ_IGNORE) {
			seqIGN();
			return;
		}

		
		if (currSeq == TYPE_SEQ_ESC) {
			seqESC(car);
			return;
		}


		if (currSeq == TYPE_SEQ_REP) {
			seqREP(car);
			return;
		}

		if (currSeq == TYPE_SEQ_POS) {
			seqPOS(car);
			return;
		}

		if (currSeq == TYPE_SEQ_G2) {
			car = seqG2(car);
			if (car == 255) {
				return;
			}
			sendToDisplay(car,true);
			correctPosCurseur();
			return;
		}
		
		if (currSeq == TYPE_SEQ_PRO2) {
			seqPRO2(car);
			return;
		}
		if (currSeq == TYPE_SEQ_PRO1) {
			seqPRO1(car);
			return;
		}
	}
	if (car <32) {
		if (car==0x07) {
			beep();
			return;
		}
		if (car==0x1D) {	//SS3
			return;
		}
		if (car==0x13) {	//SEP
			currSeq = TYPE_SEQ_IGNORE;
			seqCnt=1;
		} else if (car==VDT_ESC) {
			currSeq = TYPE_SEQ_ESC;
		} else if (car==VDT_REP) {
			currSeq = TYPE_SEQ_REP;
		} else if (car==VDT_POS) {
			currSeq = TYPE_SEQ_POS;
			seqCnt=0;
		} else if (car==VDT_G2 || car==0x16) {
			if (fontSet == FONT_G0) {
				currSeq = TYPE_SEQ_G2;
				seqCnt=0;
			}
		} else if (car==VDT_LEFT) {
			currC--;
		} else if (car==VDT_RIGHT) {
			currC++;
		} else if (car==VDT_DOWN) {
			if (ligne00==true) {
				currC=currCold;
				currL=currLold;
				ligne00 = false;
			} else currL++;
		} else if (car==VDT_UP) {
			currL--;
		} else if (car==VDT_CR) {
			currC=0;
		} else if (car==VDT_RS) {
			initAttr();
		} else if (car==VDT_CLR) {
			initVMem();
			initAttr();
			lastChar = 0;
		} else if (car==VDT_CURON) {	
			setCursor(true);
		} else if (car==VDT_CUROFF) {	
			setCursor(false);
		} else if (car==VDT_G0) {
			if (fontSet==VDT_G1)
				attUl=0;
			fontSet = FONT_G0;
			attInvert=0;
			attSize=TAILLE_NORMALE;
		} else if (car==VDT_G1 && fontSet != FONT_G1) {
			fontSet = FONT_G1;
			attInvert=0;
			attSize=TAILLE_NORMALE;
			attUl=0;
			skipDel=false;
		} else if (car==VDT_CLRLN) {
			clearEOL((byte)currL,(byte)currC);
		}
	}
	if (fontSet==FONT_G1 && car>=32) {
		car+=128;
	}
	if (car>=32)
		sendToDisplay(car,false);
	correctPosCurseur();
	return;
}




void displayFile(text filename) {
nat sz;
nat i;

	fOpen(0,filename);
	sz = fSize(0);
	curPos(8,39);
	print("cDisplaying: ",filename," [",sz," bytes]          ");


	inChar(0x1b);
	inChar(0x3a);
	inChar(0x6a);
	inChar(0x43);
	inChar(0x14);
	for (i=0;i<sz;i++) {
		fRead(0,&ii,i,1);
		inChar(ii);	
		if (getKeyDwn()==12) {
			sleep(500);
			break;
		}

	}
	fClose(0);
}

void displayDir(text dir) {
	inChar(0x0c);	
	inChar(0x0c);	
	inChar(0x0c);	

	t="";
	concat(t,dir);
	byte i=0;
	while(true) {
		if (peek(&t+i)==0)
				break;
			i++;
	}

	if (peek(&t+i-1)!=47) {
		poke(&t+i,47);
		i++;
		poke(&t+i,0);
	}


	fOpDir(dir);
	while(true) {
		bb=fRdDir(&t+i,&nn);
		if (peek(&t+i)==0)
			break;
		if (bb==false) {
			displayFile(t);
		}
		if (getKeyDwn()==12)
			return;
	}	
}

void localMode() {
byte c;
	inChar(0x11);	
	while(true) {
		c=getKey(true);
		if (c<=127)
			inChar(c);	
		else if (c==139) break;

	}
	inChar(0x14);	
}

