/////////// MISC FUNCTIONS //////////////////


void cls() {
	memSet(0x1200,3200,32); //clear screen content
	memSet(0x1e80,3200,1); //clear screen colors
}

void sleep(nat msec) {
	clkSet();
	while(_mSec<msec){}
}

void pause(bool enable) {
	if (enable==true || _keyDwn == 66) {
		nat sec=_time;
		sleep(300);
		while(_keyDwn==0) {}
		sleep(150);
	}
}

void clearSprites() {
	for (byte i=0;i<32;i++) {
		sprPos(i,0,0);
		sprFlip(i,false,false);
		sprPrio(i,0);
	}
	sprUpdt();
}

void clearTiles(){
	memSet(tilBufA,512,0);//Clear tiles buffer A
	memSet(tilBufB,512,0);//Clear tiles buffer B
}

void clearTileSet(){
	memSet(cpuWindow,32768,0,0);//Clear tileset
}


void clearBitMap(){
	memSet(cpuWindow,48000,0,bmpPageA);
	memSet(cpuWindow,48000,0,bmpPageB);
}


byte _gKeys[81]={0,49,51,53,55,57,45,127,0,0,0,0,3,97,100,103,106,108,0,0,
0,50,52,54,56,48,61,39,0,0,0,9,115,102,104,107,59,13,0,0,
0,113,101,116,117,111,91,92,0,0,0,0,120,118,110,44,47,8,0,9,
0,96,119,114,121,105,112,93,0,0,0,0,122,99,98,109,46,11,32,0,10};

byte _gKeysShift[81]={0,33,35,37,38,40,95,127,0,0,0,0,3,65,68,71,74,76,0,0,
0,64,36,94,42,41,43,34,0,0,0,9,83,70,72,75,58,13,0,0,
0,81,69,84,85,79,123,124,0,0,0,0,88,86,78,60,63,8,0,9,
0,126,87,82,89,73,80,125,0,0,0,0,90,67,66,77,62,11,32,0,10};

// Ctrl + letter keys = ASCII 1 to 26; num 0 to 4 : ASCII 27 to 31
byte _gKeysCtrl[81]={0,28,30,0,0,0,0,127,0,0,0,0,3,1,4,7,10,12,0,0,
0,29,31,0,0,27,0,0,0,0,0,9,19,6,8,11,0,13,0,0,
0,17,5,20,21,15,0,0,0,0,0,0,24,22,14,0,0,8,0,9,
0,0,23,18,25,9,16,0,0,0,0,0,26,3,2,13,0,11,32,0,10};

// Fctn : 127 + keycode


byte _gSkey;
byte getKey(bool willBlock) {
byte c;
byte k;

	while(true) {
		k=0;
		
		c=getKeyUp();
		if (c==51 || c==58) {
			_gSkey-=1; // Shift
		} else if (c==11) {
			_gSkey-=2; // Ctrl
		} else if (c==71) {
			_gSkey-=4; // Alt
		} else if (c==79) {
			_gSkey-=8; // Fctn
		}
		
		c=getKeyDwn();

		if (c==0) {
			if (willBlock==false)
				return 0;
			continue;
		}
		
		if (c==51 || c==58) {
			_gSkey+=1; // Shift
			continue;
		} else if (c==11) {
			_gSkey+=2; // Ctrl
			continue;
		} else if (c==71) {
			_gSkey+=4; // Alt
			continue;
		} else if (c==79) {
			_gSkey+=8; // Fctn
			continue;
		}
		

		if (_gSkey==0)
			return _gKeys[c];
		if (_gSkey & 1)
			return _gKeysShift[c];
		if (_gSkey & 2)
			return _gKeysCtrl[c];
		if (_gSkey & 8)
			return c+127;
	}
	return 0;
}



