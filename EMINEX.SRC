byte ProBuffer[5];

byte VDT_ESC=0x1B; 		// ESC
byte VDT_LEFT=0x08; 		// Deplacement curseur vers la gauche
byte VDT_RIGHT=0x09; 	// Deplacement curseur vers la droite
byte VDT_DOWN=0x0A; 		// Deplacement curseur vers le bas
